# ======================================
#                 INFO
# ======================================
# Below are the paths to your personal lists. They will never be overwritten by git pull.
# * rules/my-lists/allowlist.txt    - Allowlist of expressions. Matching traffic skips all managed WAF rules.
# * rules/my-lists/blocklist.txt    - The opposite of allowlist.txt. Expressions merged into whichever Part 1-5 rule has the most spare room (not a new rule - Cloudflare's per-plan rule count cap, 5 on Free, leaves no room for one).
# * rules/my-lists/ip-blocklist.txt - Your own IP addresses to block, merged automatically with the built-in rules/ip-blocklist.txt.
#
# All three files are created automatically on the script's first run.


# ======================================
# APPLICATION
# ======================================

# Application mode. Setting "production" enables a hard repository reset before each git pull.
# Allowed values: production, development
NODE_ENV=production


# ======================================
# CLOUDFLARE
# ======================================

# Account API token (cfat_ prefix) required to manage WAF rules.
# Required permissions are described in the README: https://github.com/sefinek/Cloudflare-WAF-Expressions#tutorial-for-linux
# Cloudflare dashboard > Manage Account > API Tokens > Create Token
CF_API_TOKEN=

# Cloudflare Account ID (usually 32 characters), visible in the URL after logging in: dash.cloudflare.com/<account_id>/...
# Required only for IP list synchronization (rules/ip-blocklist.txt → Cloudflare Lists).
# Without this variable, synchronization will be skipped and WAF rules will work normally, but with reduced effectiveness.
CF_ACCOUNT_ID=

# Name of the managed IP blocklist in Cloudflare. Do not create it manually - it will be created automatically.
# Allowed characters: lowercase letters, digits and underscores.
# The name is automatically injected into WAF expressions - the reference in expressions.md always matches this value.
# Leave empty to disable IP list synchronization entirely.
CF_IP_BLOCKLIST_NAME=sefinek_cf_waf

# Comma-separated list of zone names (domains) to skip during WAF rule updates.
# Not recommended - instead of this variable, restrict your API token's scope by selecting "Specified Domains" in the Account API token.
# Example: EXCLUDED_ZONES=sefinek.net,sniffcat.com
# Leave empty to update all zones.
EXCLUDED_ZONES=


# ======================================
# WAF RULE BEHAVIOR
# ======================================

# PHP support.
# false: requests to .php files trigger a Managed Challenge (Part 5).
# true: the .php rule from Part 5 is removed, .php files pass through without any verification.
PHP_SUPPORT=false

# WordPress support.
# false: requests to /wp-content and /wp-includes paths trigger a Managed Challenge (Part 5).
# true: these rules are removed so WordPress themes, plugins, CSS, images and JS load correctly.
# Recommended: also set PHP_SUPPORT=true when running a WordPress site.
WORDPRESS_SUPPORT=false


# ======================================
# SNIFFCAT INTEGRATION
# ======================================

# SniffCat API token for fetching a dynamic list of malicious IP addresses. Highly recommended for maximum effectiveness.
# Leave empty to disable this integration. More info: https://sniffcat.com
SNIFFCAT_API_TOKEN=

# Minimum confidence level (0-100) required to include an IP address from SniffCat.
# Higher values return fewer results, but with greater certainty that the IPs are actually malicious.
SNIFFCAT_CONFIDENCE_MIN=80

# Maximum number of IP addresses fetched from SniffCat in a single request.
# Together with the built-in and your own IP list, this counts toward Cloudflare's custom list item limit
# (auto-detected during synchronization - see ABUSEIPDB_LIMIT below). Unlike AbuseIPDB, SniffCat addresses
# are never automatically trimmed - if the total exceeds the available budget, AbuseIPDB entries are trimmed
# instead and a warning is logged. Keep this at a reasonable value to leave room for AbuseIPDB.
SNIFFCAT_LIMIT=2000


# ======================================
# ABUSEIPDB INTEGRATION
# ======================================

# AbuseIPDB API key for fetching a dynamic list of malicious IP addresses. Highly recommended for maximum effectiveness.
# Leave empty to disable this integration. Get a free key at: https://www.abuseipdb.com/account/api/keys
ABUSEIPDB_API_KEY=

# Minimum confidence score (0-100) required to include an IP address from AbuseIPDB.
# Higher values return fewer results, but with greater certainty that the IPs are actually malicious.
ABUSEIPDB_CONFIDENCE_MIN=75

# Maximum number of IP addresses fetched from AbuseIPDB in a single request.
# Cloudflare's custom list item limit (10,000 on Free/Pro/Business plans, shared across ALL lists on the
# account) is auto-detected during synchronization. If the combined total from all sources exceeds it,
# synchronization trims the lowest-confidence AbuseIPDB addresses and logs a warning - lower this value
# to avoid that permanently.
ABUSEIPDB_LIMIT=8000


# ======================================
# SCHEDULING
# ======================================

# Cron schedule for automatically pulling updates from the repository (git pull).
# Default: every day at 8:30. When changes are detected, the script runs "npm ci --omit=dev" and then restarts the app via PM2.
GIT_PULL_CRON="30 8 * * *"

# Cron schedule for updating WAF rules in Cloudflare.
# Default: every day at 9:00, 15:00, 18:00 and 22:00.
RULES_UPDATE_CRON="0 9,15,18,22 * * *"


# ======================================
#                 MAIL
# ======================================

# SMTP server details for sending emails when a warning or error is logged.
# All warnings/errors from a single "batch" (e.g. several zones failing during one sync) are collected
# and sent as one combined email 30 seconds after the last one, instead of a separate email per log entry.
# Leave MAILER_HOST empty to disable email notifications entirely.
MAILER_HOST=
MAILER_PORT=
MAILER_AUTH_USER=
MAILER_AUTH_PASSWD=""

# Recipient address for notifications. Leave empty to send to the same address as MAILER_AUTH_USER (i.e. to yourself).
MAILER_TO=

# Whether to also email a notification, besides warnings/errors, whenever something gets updated.
# Disabled (false) by default, to avoid cluttering the inbox on every sync with an actual change
# (e.g. after editing rules/expressions.md).
NOTIFY_ON_UPDATE_MAILER=false


# ======================================
#                DISCORD
# ======================================

# Discord webhook URL for sending the same warning/error notifications (same batching as email -
# one combined message every 30 seconds instead of a separate one per log entry). Leave empty to disable.
# Discord > Channel Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Whether to also send a notification via the Discord webhook, besides warnings/errors, whenever something
# gets updated. Independent of NOTIFY_ON_UPDATE_MAILER above. Disabled (false) by default.
NOTIFY_ON_UPDATE_DISCORD=false
